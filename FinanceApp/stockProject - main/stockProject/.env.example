# Copy to .env and adjust. Never commit the real .env file.
# =========================
# Django / API
# =========================
DJANGO_SETTINGS_MODULE=stockProject.settings
DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,api
LOG_DIR=/logs
ENV=dev
SERVICE_NAME=api
SERVICE_VERSION=1.0.0
CONTAINER_ID=api
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# =========================
# PostgreSQL
# =========================
DB_NAME=stock
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# =========================
# Celery / Redis
# =========================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TIMEZONE=UTC
# Celery Beat schedule (seconds)
SCHED_MATCH_S=5
SCHED_RATES_S=10
SCHED_BALANCES_S=7.5
SCHED_EXPIRE_S=60

# =========================
# Experiment tags (written into JSONL logs)
# =========================
EXPERIMENT_ID=exp-local
PHASE=dev
SCENARIO_ID=default

# 0 = container monitor writes JSONL only (no DB)
MONITOR_DB_ENABLED=0
